@using XmlFileProcessor;
@rendermode InteractiveWebAssembly

<p>
    Enter your XML file here:
    <br/>
    <InputFile OnChange="LoadFiles" />
</p>

<p>
    Currently loaded file:
    <br/>
    <ul>
        <li>Name: @XmlProcessor?.FileName</li>
        <li>Size: @XmlProcessor?.FileSizeMB MB</li>
    </ul>
</p>

@code {
    public XmlFileProcessor? XmlProcessor { get; set; }

    private void LoadFiles(InputFileChangeEventArgs e)
    {
        XmlProcessor = new XmlFileProcessor(e.File);
    }
}
